# Server
PORT=3000
NODE_ENV=production

# Security
SESSION_SECRET=change-this-to-a-random-secret-string

# Database path (default: ./data/nexus.db)
DB_PATH=./data/nexus.db

# ─── E-Mail (SMTP) & Stripe ───────────────────────────────────────────────
# These are NO LONGER configured via .env. Configure them in the Admin panel
# (Admin → "E-Mail (SMTP)" and "Stripe"). Values are stored in the database and
# take effect without a restart. The Base URL for email/share links is set in
# Admin → "E-Mail (SMTP)" as well.
#
# The legacy SMTP_*, STRIPE_*, and BASE_URL variables are still read as a
# one-time migration fallback for existing deployments, but any value saved in
# the Admin panel always takes precedence.
