# Server
PORT=3000
NODE_ENV=production

# Security
SESSION_SECRET=change-this-to-a-random-secret-string

# Optional: Base URL for sharing links (set to your VPS domain)
BASE_URL=http://localhost:3000

# Database path (default: ./data/nexus.db)
DB_PATH=./data/nexus.db

# ─── Email (Postfix relay on the VPS, no auth) ────────────────────────────
# If SMTP_HOST is unset, emails are logged to the console (dev mode).
SMTP_HOST=host.docker.internal
SMTP_PORT=25
SMTP_SECURE=false
SMTP_FROM=noreply@exzellenzschmiede.de
# SMTP_USER / SMTP_PASS: leave empty — Postfix relay accepts unauthenticated mail
# SMTP_USER=
# SMTP_PASS=

# ─── Stripe (subscriptions) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
# Optional annual prices
# STRIPE_PRICE_PRO_ANNUAL=price_xxx
# STRIPE_PRICE_BUSINESS_ANNUAL=price_xxx
